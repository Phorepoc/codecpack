// eaacplusutil.mmp -- OURS (the optional AAC codec pack): the AAC header utility, behind the release stub's frozen
// export list (os.mmaudio/eaacplusutil_stub/eabi/eaacplusutil_stubu.def, given in registry/components_codecpack.py)
TARGET			eaacplusutil.dll
TARGETTYPE		dll
UID				0x1000008d 0xE701571D
CAPABILITY		ALL -Tcb
VENDORID		0

SOURCEPATH		../src
SOURCE			eaacplusutil.cpp
OS_LAYER_SYSTEMINCLUDE
SYSTEMINCLUDE	/epoc32/include/platform
LIBRARY			euser.lib
