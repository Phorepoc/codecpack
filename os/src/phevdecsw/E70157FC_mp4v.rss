// E70157FC_mp4v.rss -- OURS: ECOM registration of the codec pack's software DevVideo decoder phevdecsw.dll, ARM build: MPEG-4 Part 2 only
// (interface 0x101FB4BE = KUidDevVideoDecoderHwDevice, the one CMMFDevVideoPlay::FindDecodersL looks under).
#include <ecom/registryinfo.rh>

RESOURCE REGISTRY_INFO theInfo
    {
    dll_uid     = 0xE70157FC;
    interfaces  =
        {
        INTERFACE_INFO
            {
            interface_uid   = 0x101FB4BE;
            implementations =
                {
                IMPLEMENTATION_INFO
                    {
                    implementation_uid  = 0xE70157FD;
                    version_no          = 1;
                    display_name        = "Phorepoc software decoder (FFmpeg: MPEG-4 Part 2)";
                    // the MIME types it decodes, matched (with wildcards) against the query; '||' separates them
                    default_data        = "video/mp4v-es*||";
                    // the post-processing it does itself (TPrePostProcessType bits): none
                    opaque_data         = "0";
                    }
                };
            }
        };
    }
