// phevdecsw.mmp -- OURS: the codec pack's software DevVideo decoder (phevdecsw.dll, UIDs E70157FC / E70157FD), ARM
// build: MPEG-4 Part 2 only (PHE_MP4V) -- the hardware video decoder in the ROM does H.264 / MPEG-2. Decodes through
// pheffmpeg.dll. Installed with the codec pack (sys/bin + resource/plugins), never in an OS image.

TARGET			phevdecsw.dll
TARGETTYPE		PLUGIN
UID				0x10009D8D 0xE70157FC
CAPABILITY		All -TCB
VENDORID		0

MACRO			PHE_SW PHE_MP4V
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
USERINCLUDE		.
SOURCEPATH		.
SOURCE			phevdec.cpp h264_parser.cpp

START RESOURCE	E70157FC_mp4v.rss
TARGET			phevdecsw.rsc
END

LIBRARY			euser.lib devvideo.lib hal.lib
